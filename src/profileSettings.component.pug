.form-line
    .header
        .title {{ t('arc.profile.host.title') }}
        .description {{ t('arc.profile.host.desc') }}
    input.form-control(
        type='text',
        [(ngModel)]='profile.options.host',
        placeholder='192.168.1.10')

.form-line
    .header
        .title {{ t('arc.profile.port.title') }}
        .description {{ t('arc.profile.port.desc') }}
    input.form-control(
        type='number',
        [(ngModel)]='profile.options.port')

.form-line
    .header
        .title {{ t('arc.profile.username.title') }}
        .description {{ t('arc.profile.username.desc') }}
    input.form-control(
        type='text',
        [(ngModel)]='profile.options.username')

.form-line
    .header
        .title {{ t('arc.profile.domain.title') }}
        .description {{ t('arc.profile.domain.desc') }}
    input.form-control(
        type='text',
        [(ngModel)]='profile.options.domain')

.form-line
    .header
        .title {{ t('arc.profile.password.title') }}
        .description(*ngIf='passwordLoaded') {{ t('arc.profile.password.storage', { store: credentials.storageName() }) }}
        .description(*ngIf='!passwordLoaded') ...
    input.form-control(
        type='password',
        [ngModel]='passwordValue',
        (ngModelChange)='onPasswordChange($event)',
        placeholder="{{ t('arc.profile.password.placeholder') }}")

.form-line
    .header
        .title {{ t('arc.profile.size.title') }}
        .description {{ t('arc.profile.size.desc') }}
    input.form-control(
        type='number',
        [(ngModel)]='profile.options.width',
        placeholder="{{ t('arc.profile.size.width') }}")
    input.form-control(
        type='number',
        [(ngModel)]='profile.options.height',
        placeholder="{{ t('arc.profile.size.height') }}")

.form-line
    .header
        .title {{ t('arc.profile.credssp.title') }}
        .description {{ t('arc.profile.credssp.desc') }}
    input.form-check-input(
        type='checkbox',
        [(ngModel)]='profile.options.enableCredSsp')
