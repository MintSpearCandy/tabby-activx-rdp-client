h2 ActiveX RDP

.form-line
    .header
        .title {{ t('arc.settings.about.title') }}
        .description {{ t('arc.settings.about.desc') }}

.form-line(*ngIf='diag?.status === "ok"')
    .header
        .title {{ t('arc.settings.addon.title') }}
        .description {{ t('arc.settings.bridge.ok') }}

.form-line(*ngIf='diag && diag.status !== "ok"')
    .header
        .title {{ t('arc.settings.bridge.bad') }}
        .description {{ diag.detail }}

.form-line(*ngIf='addonPath')
    .header
        .title {{ t('arc.settings.addon.title') }}
        .description {{ t('arc.settings.addon.desc', { path: addonPath }) }}

.form-line
    .header
        .title {{ t('arc.settings.passwords.title') }}
        .description {{ t('arc.settings.passwords.desc') }}

.form-line
    .header
        .title {{ t('arc.settings.keyboard.title') }}
        .description {{ t('arc.settings.keyboard.desc') }}
